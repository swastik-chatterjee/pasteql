# Copy this file to .env and fill in your real remote Postgres values.
# This app reads .env automatically at startup.
PG_CONNECTION_STRING="Host=your-db-host.example.com;Port=5432;Database=pasteql;Username=pasteql_user;Password=super-secret-password;SSL Mode=Require;"
ASPNETCORE_ENVIRONMENT="Production"
ASPNETCORE_URLS="http://+:8080"
