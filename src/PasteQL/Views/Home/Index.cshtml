@model PasteCreateViewModel

<section class="home-intro">
    <span class="eyebrow">A better place for your snippets</span>
    <h1>Share code, not the mess.</h1>
    <p>A private, self-hosted home for the notes, logs, and code you need to share. Create a paste in seconds, then choose exactly how long it stays around.</p>
</section>

<div class="create-layout">
    <section class="card composer">
        <div class="composer-heading">
            <div>
                <span class="eyebrow">New paste</span>
                <h2>Start with your content</h2>
                <p>Add a title and set your sharing preferences.</p>
            </div>
            <span class="private-badge">Private by default</span>
        </div>

        <form asp-controller="Paste" asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="notice" role="alert"></div>
            <div class="grid-2">
                <div class="form-field">
                    <label asp-for="Title"></label>
                    <input asp-for="Title" />
                </div>
                <div class="form-field">
                    <label asp-for="Language"></label>
                    <select asp-for="Language">
                        <option value="text">text</option>
                        <option value="csharp">csharp</option>
                        <option value="json">json</option>
                        <option value="sql">sql</option>
                        <option value="bash">bash</option>
                        <option value="html">html</option>
                        <option value="javascript">javascript</option>
                        <option value="yaml">yaml</option>
                    </select>
                </div>
            </div>

            <div class="form-field">
                <label asp-for="Content"></label>
                <textarea asp-for="Content" placeholder="Paste your code, logs, notes, or markdown here..."></textarea>
            </div>

            <div class="grid-2">
                <div class="form-field">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" type="password" placeholder="Optional" autocomplete="new-password" />
                </div>
                <div class="form-field">
                    <label asp-for="ExpiresInMinutes"></label>
                    <input asp-for="ExpiresInMinutes" type="number" min="1" max="525600" />
                </div>
            </div>

            <div class="grid-2">
                <div class="form-field">
                    <label asp-for="MaxViews"></label>
                    <input asp-for="MaxViews" type="number" min="0" max="1000" value="0" />
                </div>
                <div class="checkbox-field">
                    <label asp-for="BurnAfterRead" class="checkbox-control">
                        <input asp-for="BurnAfterRead" />
                        <span>Burn after read</span>
                    </label>
                </div>
            </div>

            <button class="button-primary" type="submit">Create paste <span aria-hidden="true">→</span></button>
            <p class="form-footnote">Your content is protected at rest and only shared with the link you create.</p>
        </form>
    </section>

    <aside class="card feature-panel">
        <span class="eyebrow">Made for developers</span>
        <h2>Your snippets, on your terms.</h2>
        <p>Everything you need to share useful context without giving up control.</p>
        <ul class="feature-list">
            <li><span class="feature-icon" aria-hidden="true">01</span><span><strong>Protected at rest</strong>Encrypted storage with ASP.NET Data Protection.</span></li>
            <li><span class="feature-icon" aria-hidden="true">02</span><span><strong>Readable by default</strong>Markdown rendering and syntax highlighting.</span></li>
            <li><span class="feature-icon" aria-hidden="true">03</span><span><strong>Gone when you say</strong>Set an expiry, view limit, or burn after read.</span></li>
            <li><span class="feature-icon" aria-hidden="true">04</span><span><strong>API included</strong>Query pastes through the native GraphQL endpoint.</span></li>
        </ul>
    </aside>
</div>
